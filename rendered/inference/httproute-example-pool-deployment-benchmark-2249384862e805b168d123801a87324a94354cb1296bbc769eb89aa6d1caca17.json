{
  "apiVersion": "gateway.networking.k8s.io/v1",
  "kind": "HTTPRoute",
  "metadata": {
    "name": "example-pool-deployment-benchmark",
    "namespace": "thalamus-inference"
  },
  "spec": {
    "hostnames": [
      "pool-inference.example.invalid"
    ],
    "parentRefs": [
      {
        "group": "gateway.networking.k8s.io",
        "kind": "Gateway",
        "name": "inference-serving",
        "namespace": "thalamus-inference"
      }
    ],
    "rules": [
      {
        "backendRefs": [
          {
            "group": "inference.networking.k8s.io",
            "kind": "InferencePool",
            "name": "example-pool-deployment-inference-pool",
            "weight": 1
          }
        ],
        "filters": [
          {
            "type": "URLRewrite",
            "urlRewrite": {
              "path": {
                "replaceFullPath": "/v1/completions",
                "type": "ReplaceFullPath"
              }
            }
          },
          {
            "responseHeaderModifier": {
              "set": [
                {
                  "name": "x-thalamus-backend",
                  "value": "example-pool-service/example-pool-deployment/5555555555555555555555555555555555555555555555555555555555555555"
                }
              ]
            },
            "type": "ResponseHeaderModifier"
          }
        ],
        "matches": [
          {
            "method": "POST",
            "path": {
              "type": "Exact",
              "value": "/candidates/example-pool-deployment/v1/completions"
            }
          }
        ]
      }
    ]
  }
}
