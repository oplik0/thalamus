{
  "apiVersion": "gateway.networking.k8s.io/v1",
  "kind": "HTTPRoute",
  "metadata": {
    "name": "example-pool-service",
    "namespace": "thalamus-inference"
  },
  "spec": {
    "hostnames": [
      "pool-inference.example.invalid"
    ],
    "parentRefs": [
      {
        "group": "gateway.networking.k8s.io",
        "kind": "Gateway",
        "name": "inference-serving",
        "namespace": "thalamus-inference"
      }
    ],
    "rules": [
      {
        "backendRefs": [
          {
            "group": "agentgateway.dev",
            "kind": "AgentgatewayBackend",
            "name": "example-pool-deployment-backend",
            "weight": 1
          }
        ],
        "matches": [
          {
            "method": "POST",
            "path": {
              "type": "Exact",
              "value": "/v1/chat/completions"
            }
          }
        ]
      }
    ]
  }
}
