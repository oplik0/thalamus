{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "example-pool-deployment-epp",
    "namespace": "thalamus-inference"
  },
  "spec": {
    "ports": [
      {
        "appProtocol": "kubernetes.io/h2c",
        "name": "grpc-ext-proc",
        "port": 9002,
        "protocol": "TCP",
        "targetPort": 9002
      },
      {
        "name": "http-metrics",
        "port": 9090,
        "protocol": "TCP",
        "targetPort": 9090
      }
    ],
    "selector": {
      "app.kubernetes.io/name": "example-pool-deployment-epp"
    }
  }
}
